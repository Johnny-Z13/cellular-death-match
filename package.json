{
  "name": "cellular-death-match",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run credits:crazygames:check",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "qa:mobile": "playwright test e2e/responsive.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:e2e && npm run build",
    "preview": "vite preview",
    "generate:audio": "node scripts/generate-audio-assets.mjs",
    "audio:manifest": "node scripts/generate-audio-assets.mjs --manifest-only",
    "generate:keyart": "node scripts/generate-keyart.mjs",
    "credits:crazygames": "node scripts/sync-crazygames-attributions.mjs --write",
    "credits:crazygames:check": "node scripts/sync-crazygames-attributions.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "sharp": "^0.35.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
